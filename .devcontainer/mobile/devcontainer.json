{
  "name": "Immich - Mobile",
  "service": "immich-server",
  "runServices": [
    "immich-init",
    "immich-server",
    "redis",
    "database",
    "immich-machine-learning"
  ],
  "dockerComposeFile": [
    "../../docker/docker-compose.dev.yml",
    "./container-compose-overrides.yml"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "dcmdev.dcm-vscode-extension",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "svelte.svelte-vscode",
        "ms-vscode-remote.remote-containers",
        "foxundermoon.shell-format",
        "timonwong.shellcheck",
        "rvest.vs-code-prettier-eslint",
        "bluebrown.yamlfmt",
        "vkrishna04.cspell-sync",
        "vitest.explorer",
        "ms-playwright.playwright",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "forwardPorts": [],
  "overrideCommand": true,
  "workspaceFolder": "/usr/src/app",
  "remoteUser": "node",
  "userEnvProbe": "loginInteractiveShell",
  // ----------- daniel -------------
  // Provision the mobile build toolchain (Flutter 3.41.9 / Android SDK / JDK)
  // into .mobile-tools on container create. Idempotent — re-runs skip in seconds.
  "postCreateCommand": "bash .devcontainer/mobile/install-mobile-toolchain.sh",
  // ---------------------------------
  "remoteEnv": {
    // The location where your uploaded files are stored
    "UPLOAD_LOCATION": "${localEnv:UPLOAD_LOCATION:./library}",
    //  Connection secret for postgres. You should change it to a random password
    //  Please use only the characters `A-Za-z0-9`, without special characters or spaces
    "DB_PASSWORD": "${localEnv:DB_PASSWORD:postgres}",
    //  The database username
    "DB_USERNAME": "${localEnv:DB_USERNAME:postgres}",
    //  The database name
    "DB_DATABASE_NAME": "${localEnv:DB_DATABASE_NAME:immich}",
    // Keep Claude Code config on the bind-mounted workspace so it survives rebuilds
    "CLAUDE_CONFIG_DIR": "/usr/src/app/.claude",
    // ----------- daniel -------------
    // Flutter + Android SDK + JDK live under the bind-mounted workspace
    // (.mobile-tools) so they survive devcontainer rebuilds. Lets `flutter run`
    // build for Android. Flutter 3.41.9 here (pinned by mobile/mise.toml) is put
    // ahead of the image's baked-in /flutter (3.35.7, too old for the project).
    "FLUTTER_HOME": "/usr/src/app/.mobile-tools/flutter",
    "JAVA_HOME": "/usr/src/app/.mobile-tools/jdk-21",
    "ANDROID_HOME": "/usr/src/app/.mobile-tools/android-sdk",
    "ANDROID_SDK_ROOT": "/usr/src/app/.mobile-tools/android-sdk",
    // Persist adb keys here so the phone stays authorized across rebuilds
    "ANDROID_USER_HOME": "/usr/src/app/.mobile-tools/android-user",
    // Keep Gradle / pub caches on the bind-mount so rebuilds don't re-download
    "GRADLE_USER_HOME": "/usr/src/app/.mobile-tools/gradle",
    "PUB_CACHE": "/usr/src/app/.mobile-tools/pub-cache",
    "PATH": "/usr/src/app/.mobile-tools/flutter/bin:/usr/src/app/.mobile-tools/jdk-21/bin:/usr/src/app/.mobile-tools/android-sdk/platform-tools:/usr/src/app/.mobile-tools/android-sdk/cmdline-tools/latest/bin:${containerEnv:PATH}"
    // ---------------------------------
  }
}
